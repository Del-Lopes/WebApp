# Edge Function Secrets — generate-articles
# Configure no Supabase Dashboard → Edge Functions → Secrets
# (não commite o arquivo .env real — apenas este .env.example)

# Obrigatório: geração do artigo via IA
GEMINI_API_KEY=     # Google AI Studio — aistudio.google.com/app/apikey

# Opcional: fallback se Gemini falhar (Groq Llama 3.3 70B)
GROQ_API_KEY=       # console.groq.com

# Disponíveis automaticamente nas Edge Functions — não precisam ser configuradas
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
